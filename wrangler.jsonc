{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ig-voice-reply",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // AswinCloud account — the one that owns the aswincloud.com zone.
  "account_id": "e38978124c8fdb38dc80c04cda318ab3",
  "observability": { "enabled": true },

  // custom_domain creates and manages the DNS record itself. Meta needs a public
  // HTTPS callback for the webhook, and Instagram fetches each voice note from
  // this origin, so the Worker must be reachable on the open internet.
  "routes": [{ "pattern": "ig-reply.aswincloud.com", "custom_domain": true }],

  // One namespace, key-prefixed:
  //   audio:<uuid>        the WAV Instagram fetches, TTL 5 min
  //   seen:<mid>          webhook dedupe, TTL 10 min
  //   last_reply:<igsid>  cooldown timestamp
  //   health:token        cached result of the live token check, TTL 5 min
  //   echo:last           most recent recipient of a message the owner sent, TTL 7 days
  //   discovery:last      most recent inbound sender while unallowlisted, TTL 7 days
  //   discovery:chatwoot  same, for the Chatwoot route (contact id, username, igsid), TTL 7 days
  //   seen:cw:<id>        Chatwoot webhook dedupe, TTL 10 min
  //   history:cw:<id>     conversation context for a Chatwoot contact, TTL 48 h
  //   health:chatwoot     cached result of the Chatwoot token check, TTL 5 min
  "kv_namespaces": [{ "binding": "KV", "id": "a12760194cd24c1796d1c8379a79b6ae" }],


  // Non-secret configuration. Secrets are set with `wrangler secret put` and
  // listed in .dev.vars.example — never here.
  "vars": {
    "PUBLIC_ORIGIN": "https://ig-reply.aswincloud.com",
    "GRAPH_API_VERSION": "v24.0",
    // eleven_v4 (released 2026-09-28): most expressive, follows audio tags like
    // [laughs] more closely than v3; 90+ languages incl. Tamil. eleven_v4_turbo is the
    // low-latency variant. Replies are Tamil script (see src/prompt.ts), which is
    // pronounced as Tamil; Latin-letter Tanglish is read as English and sounds wrong.
    // Credits are taken from the `character-cost` response header, so a model's
    // pricing never needs to be encoded here.
    "ELEVENLABS_MODEL_ID": "eleven_v4",
    // 0 = reply to every message. Set to e.g. 60 for one reply per hour.
    "REPLY_COOLDOWN_MINUTES": "0",
    // Reply generation. The persona lives in src/prompt.ts.
    "ANTHROPIC_MODEL": "claude-opus-5-5",
    "MAX_REPLY_CHARS": "180",
    // ElevenLabs credits per day (owner's day, Asia/Kolkata). Counted as characters
    // sent to TTS. When the remainder is too small for another reply, SIGNOFF_TEXT
    // is spoken once and the Worker stays quiet until the next day. 0 disables.
    "DAILY_CREDIT_LIMIT": "1500",
    "SIGNOFF_TEXT": "சரி, எனக்கு கொஞ்சம் வேலை இருக்கு. நான் அப்புறம் பேசுறேன்!",
    // Spoken when Claude declines the topic (18+ etc.) — a light deflection.
    "REFUSAL_TEXT": "ஐயோ, அதைப் பற்றி வேணாம் டா. வேற எதாவது சொல்லு!",
    // Spoken when Claude is unavailable, so the friend still hears something. Keeps
    // the conversation open ("didn't catch that, say it again?") rather than
    // promising that Aswin will reply later.
    "FALLBACK_TEXT": "ஹே, சரியா கேக்கல டா. இன்னொரு தடவ சொல்லு?",
    // Chatwoot route (README, "Reaching people who hold no role on the Meta app").
    // Self-hosted Chatwoot (~/chatwoot) with an Instagram inbox on the Instagram-Login route,
    // which delivers everyone's DMs; API and webhooks are free when self-hosted.
    // The account id is the number in the Chatwoot URL: /app/accounts/<id>/...
    // CHATWOOT_INBOX_ID narrows to one inbox; empty acts on every inbox in the account.
    "CHATWOOT_BASE_URL": "https://support.aswincloud.com",
    "CHATWOOT_ACCOUNT_ID": "2",
    "CHATWOOT_INBOX_ID": "6"
  }
}
