# Copy to .dev.vars for `wrangler dev`. In production set each with:
#   npx wrangler secret put NAME
# None of these belong in git.

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# The voice to speak in. Your own cloned voice works here.
ELEVENLABS_VOICE_ID=

# Anthropic — generates each reply from what the friend wrote (persona: src/prompt.ts).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: a gateway in front of the API. Leave empty for api.anthropic.com.
ANTHROPIC_BASE_URL=

# Meta developer app (Instagram API with Instagram Login)
# App settings -> Basic -> App Secret. Used to verify webhook signatures.
META_APP_SECRET=
# A string you invent; paste the same value into the webhook config on Meta's side.
WEBHOOK_VERIFY_TOKEN=
# A PAGE access token for the Facebook Page linked to the Instagram account.
# Derived from a long-lived user token it never expires (README, "Meta setup").
IG_ACCESS_TOKEN=
# The Facebook Page id. Sends go through the Page: POST /{IG_PAGE_ID}/messages.
IG_PAGE_ID=
# The Instagram professional account id (17841...). Webhook entries carry this.
IG_USER_ID=

# The ONE person to reply to: their Instagram-scoped user ID. Leave unset at first;
# the Worker logs the sender ID of incoming messages until this is configured.
ALLOWED_IGSID=

# Chatwoot route — reaches people who hold no role on the Meta app (README).
# Profile Settings -> Access Token, for the agent the replies should appear from.
CHATWOOT_API_TOKEN=
# Invent an unguessable string (e.g. `openssl rand -hex 24`). The webhook URL you
# give Chatwoot is https://<PUBLIC_ORIGIN>/chatwoot/<this value>.
CHATWOOT_WEBHOOK_TOKEN=
# Optional: if the Chatwoot webhook offers a signing secret, put it here too and
# every delivery must carry a valid X-Chatwoot-Signature.
CHATWOOT_WEBHOOK_SECRET=
# The ONE person to reply to on this route: their Instagram username (with or
# without @) or their Chatwoot contact id. Leave unset at first; the Worker logs
# each incoming sender until this is configured.
CHATWOOT_ALLOWED_CONTACT=
